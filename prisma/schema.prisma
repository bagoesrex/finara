generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum AccountType {
  CASH
  BANK
  E_WALLET
}

enum CategoryType {
  INCOME
  EXPENSE
}

model User {
  id             String         @id @default(dbgenerated("pg_catalog.gen_random_uuid()")) @db.Uuid
  name           String
  email          String         @unique
  emailVerified  Boolean        @default(false)
  image          String?
  accounts       Account[]
  categories     Category[]
  authSessions   AuthSession[]
  authIdentities AuthIdentity[]
  createdAt      DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime       @updatedAt @db.Timestamptz(3)
}

model AuthSession {
  id        String   @id @default(dbgenerated("pg_catalog.gen_random_uuid()")) @db.Uuid
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime @db.Timestamptz(3)
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@index([userId])
}

model AuthIdentity {
  id                    String    @id @default(dbgenerated("pg_catalog.gen_random_uuid()")) @db.Uuid
  userId                String    @db.Uuid
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  issuer                String
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime? @db.Timestamptz(3)
  refreshTokenExpiresAt DateTime? @db.Timestamptz(3)
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime  @updatedAt @db.Timestamptz(3)

  @@unique([issuer, accountId], map: "AuthIdentity_issuer_accountId_uidx")
  @@index([userId])
}

model AuthVerification {
  id         String   @id @default(dbgenerated("pg_catalog.gen_random_uuid()")) @db.Uuid
  identifier String
  value      String
  expiresAt  DateTime @db.Timestamptz(3)
  createdAt  DateTime @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @db.Timestamptz(3)

  @@index([identifier])
}

model AuthRateLimit {
  id          String @id @default(dbgenerated("pg_catalog.gen_random_uuid()")) @db.Uuid
  key         String @unique
  count       Int
  lastRequest BigInt @db.BigInt
}

model Account {
  id               String      @id @default(uuid()) @db.Uuid
  userId           String      @db.Uuid
  user             User        @relation(fields: [userId], references: [id], onDelete: Restrict)
  name             String
  type             AccountType
  openingBalance   BigInt      @db.BigInt
  openingBalanceAt DateTime    @default(now()) @db.Timestamptz(3)
  createdAt        DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime    @updatedAt @db.Timestamptz(3)

  @@index([userId])
}

model Category {
  id        String       @id @default(uuid()) @db.Uuid
  userId    String       @db.Uuid
  user      User         @relation(fields: [userId], references: [id], onDelete: Restrict)
  name      String
  type      CategoryType
  createdAt DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt DateTime     @updatedAt @db.Timestamptz(3)

  @@index([userId, type])
}
