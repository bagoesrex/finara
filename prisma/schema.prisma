generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum AccountType {
  CASH
  BANK
  E_WALLET
}

enum TransactionType {
  INCOME
  EXPENSE

  @@map("CategoryType")
}

model User {
  id             String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name           String
  email          String         @unique
  emailVerified  Boolean        @default(false)
  image          String?
  accounts       Account[]
  budgets        Budget[]
  categories     Category[]
  transactions   Transaction[]
  aiRateLimit    AiRateLimit?
  authSessions   AuthSession[]
  authIdentities AuthIdentity[]
  createdAt      DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime       @updatedAt @db.Timestamptz(3)
}

model AuthSession {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime @db.Timestamptz(3)
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@index([userId])
}

model AuthIdentity {
  id                    String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId                String    @db.Uuid
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  issuer                String
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime? @db.Timestamptz(3)
  refreshTokenExpiresAt DateTime? @db.Timestamptz(3)
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime  @updatedAt @db.Timestamptz(3)

  @@unique([issuer, accountId], map: "AuthIdentity_issuer_accountId_uidx")
  @@index([userId])
}

model AuthVerification {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  identifier String
  value      String
  expiresAt  DateTime @db.Timestamptz(3)
  createdAt  DateTime @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @db.Timestamptz(3)

  @@index([identifier])
}

model AuthRateLimit {
  id          String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  key         String @unique
  count       Int
  lastRequest BigInt @db.BigInt
}

model AiRateLimit {
  userId          String   @id @db.Uuid
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  windowStartedAt DateTime @db.Timestamptz(3)
  requestCount    Int
  updatedAt       DateTime @updatedAt @db.Timestamptz(3)
}

model Account {
  id               String      @id @default(uuid()) @db.Uuid
  userId           String      @db.Uuid
  user             User        @relation(fields: [userId], references: [id], onDelete: Restrict)
  transactions     Transaction[]
  name             String
  type             AccountType
  openingBalance   BigInt      @db.BigInt
  openingBalanceAt DateTime    @default(now()) @db.Timestamptz(3)
  createdAt        DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime    @updatedAt @db.Timestamptz(3)

  @@index([userId])
  @@unique([id, userId])
}

model Category {
  id           String          @id @default(uuid()) @db.Uuid
  userId       String          @db.Uuid
  user         User            @relation(fields: [userId], references: [id], onDelete: Restrict)
  name         String
  type         TransactionType
  transactions Transaction[]
  budgets      Budget[]
  createdAt    DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime        @updatedAt @db.Timestamptz(3)

  @@index([userId, type])
  @@unique([id, userId, type])
}

model Budget {
  id           String          @id @default(uuid()) @db.Uuid
  userId       String          @db.Uuid
  user         User            @relation(fields: [userId], references: [id], onDelete: Restrict)
  categoryId   String          @db.Uuid
  categoryType TransactionType @default(EXPENSE)
  category     Category        @relation(fields: [categoryId, userId, categoryType], references: [id, userId, type], onDelete: Restrict)
  periodStart  DateTime        @db.Date
  amount       BigInt          @db.BigInt
  createdAt    DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime        @updatedAt @db.Timestamptz(3)

  @@unique([userId, categoryId, periodStart])
  @@index([userId, periodStart])
}

model Transaction {
  id                String          @id @default(uuid()) @db.Uuid
  userId            String          @db.Uuid
  user              User            @relation(fields: [userId], references: [id], onDelete: Restrict)
  accountId         String          @db.Uuid
  account           Account         @relation(fields: [accountId, userId], references: [id, userId], onDelete: Restrict)
  categoryId        String          @db.Uuid
  category          Category        @relation(fields: [categoryId, userId, type], references: [id, userId, type], onDelete: Restrict)
  type              TransactionType
  amount            BigInt          @db.BigInt
  description       String
  transactionDate   DateTime        @db.Date
  transactionTime   DateTime?       @db.Time(0)
  clientRequestId   String          @db.Uuid
  deletedAt         DateTime?       @db.Timestamptz(3)
  createdAt         DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime        @updatedAt @db.Timestamptz(3)

  @@unique([userId, clientRequestId])
  @@index([userId, deletedAt, transactionDate(sort: Desc), createdAt(sort: Desc)])
  @@index([accountId, deletedAt, transactionDate])
  @@index([categoryId, deletedAt, transactionDate])
}
