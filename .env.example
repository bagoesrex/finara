# PostgreSQL connection used only by server-side code and Prisma CLI.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"
BETTER_AUTH_URL="http://localhost:3000"
BETTER_AUTH_SECRET="generate-a-random-secret-with-at-least-32-characters"
# Set only when a trusted reverse proxy overwrites this single-value header.
# BETTER_AUTH_TRUSTED_IP_HEADER="x-real-ip"

# AI inference (OpenAI-compatible endpoints e.g. 9router, OpenRouter, Groq, Ollama).
AI_API_KEY="replace-with-ai-api-key"
# Optional; defaults to https://openrouter.ai/api/v1 (or https://api.9router.com/v1)
# AI_BASE_URL="https://openrouter.ai/api/v1"
# Optional; defaults to meta-llama/llama-3.3-70b-instruct
# AI_MODEL="meta-llama/llama-3.3-70b-instruct"

# Legacy fallback: NVIDIA Build hosted inference (used if AI_API_KEY is unset)
# NVIDIA_API_KEY="replace-with-a-build-nvidia-api-key"
# NVIDIA_MODEL="nvidia/nemotron-3.5-lightning-30b-a3b"
# Optional AI preview quota overrides; defaults to 10 requests per 60 seconds.
# AI_PREVIEW_RATE_LIMIT_MAX="10"
# AI_PREVIEW_RATE_LIMIT_WINDOW_SECONDS="60"
